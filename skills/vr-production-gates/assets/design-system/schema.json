{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Real-estate storyboard content structure; style defaults are recommendations",
  "type": "object",
  "required": [
    "schema",
    "design_system",
    "plan",
    "scope",
    "assets",
    "segments"
  ],
  "properties": {
    "schema": {
      "const": "vr-production-plan/v3"
    },
    "design_system": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "const": "real-estate-storyboard"
        },
        "version": {
          "enum": [
            "1.0.0",
            "1.1.0",
            "1.2.0"
          ]
        }
      }
    },
    "plan": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "source_namespace",
        "duration_s",
        "opening",
        "ending",
        "render_method"
      ],
      "properties": {
        "duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "shot_constraints": {
          "$ref": "#/$defs/shot_constraints"
        },
        "route_space_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "editing_policy": {
          "type": "object",
          "required": [
            "single_take_required",
            "allow_cuts",
            "allow_remove_intervals",
            "allow_speed_changes"
          ],
          "properties": {
            "single_take_required": {
              "type": "boolean"
            },
            "allow_cuts": {
              "type": "boolean"
            },
            "allow_remove_intervals": {
              "type": "boolean"
            },
            "allow_speed_changes": {
              "type": "boolean"
            }
          }
        },
        "editing_source_duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "speed_map": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "source_start_s",
              "source_end_s",
              "speed"
            ],
            "properties": {
              "source_start_s": {
                "type": "number",
                "minimum": 0
              },
              "source_end_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "speed": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "continuous_edit_evidence": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "origin"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "origin": {
            "enum": [
              "actual_source",
              "synthetic_fixture",
              "actual_render_review",
              "rendered_board",
              "actual_run",
              "render_source",
              "actual_review"
            ]
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/segment"
      }
    },
    "review_route": {
      "$ref": "#/$defs/review_route"
    }
  },
  "$defs": {
    "shot_constraints": {
      "type": "object",
      "required": [
        "duration_range_s",
        "excluded_spaces",
        "avoid_wall_facing"
      ],
      "properties": {
        "duration_range_s": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "excluded_spaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "avoid_wall_facing": {
          "type": "boolean"
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "kind",
        "label"
      ],
      "properties": {
        "kind": {
          "enum": [
            "static",
            "pan",
            "travel",
            "orbit",
            "fov"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "motion": {
      "oneOf": [
        {
          "$ref": "#/$defs/step"
        },
        {
          "type": "object",
          "required": [
            "steps"
          ],
          "properties": {
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/step"
              }
            }
          },
          "not": {
            "required": [
              "kind"
            ]
          }
        }
      ]
    },
    "visual": {
      "type": "object",
      "required": [
        "role",
        "title",
        "layout",
        "motion"
      ],
      "properties": {
        "role": {
          "enum": [
            "opening",
            "chapter",
            "ending"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "layout": {
          "enum": [
            "source_reference",
            "opening_composite",
            "ending_composite"
          ]
        },
        "motion": {
          "$ref": "#/$defs/motion"
        },
        "risk_level": {
          "enum": [
            "info",
            "limitation",
            "pending"
          ]
        },
        "headline_lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cta": {
          "type": "string"
        },
        "disclaimer": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "opening"
              }
            }
          },
          "then": {
            "properties": {
              "layout": {
                "const": "opening_composite"
              }
            },
            "required": [
              "headline_lines"
            ]
          }
        }
      ]
    },
    "segment": {
      "type": "object",
      "required": [
        "id",
        "start_s",
        "end_s",
        "reference_image",
        "action",
        "focus",
        "visual"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^S[0-9]{2,}$"
        },
        "start_s": {
          "type": "number",
          "minimum": 0
        },
        "end_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reference_image": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "focus": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "risk": {
          "type": "string"
        },
        "visual": {
          "$ref": "#/$defs/visual"
        },
        "space_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "framing_status": {
          "enum": [
            "subject",
            "pending",
            "blank_wall",
            "cabinet_door"
          ]
        }
      }
    },
    "review_route": {
      "type": "object",
      "required": [
        "purpose",
        "included_in_video",
        "floorplan",
        "route",
        "nodes",
        "chapters",
        "caption"
      ],
      "properties": {
        "purpose": {
          "const": "script_review_only"
        },
        "included_in_video": {
          "const": false
        },
        "floorplan": {
          "type": "string",
          "minLength": 1
        },
        "route": {
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "type": "string",
          "minLength": 1
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "pano_index",
              "floorplan_xy"
            ],
            "properties": {
              "pano_index": {
                "type": "integer",
                "minimum": 0
              },
              "floorplan_xy": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            }
          }
        },
        "chapters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "start_s",
              "end_s",
              "pano_indices",
              "stop_pano",
              "motion_kind"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^S[0-9]{2,}$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "start_s": {
                "type": "number",
                "minimum": 0
              },
              "end_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "pano_indices": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "stop_pano": {
                "type": "integer",
                "minimum": 0
              },
              "motion_kind": {
                "enum": [
                  "static",
                  "pan",
                  "travel",
                  "orbit",
                  "fov"
                ]
              }
            }
          }
        },
        "cuts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from_pano",
              "to_pano",
              "label"
            ],
            "properties": {
              "from_pano": {
                "type": "integer",
                "minimum": 0
              },
              "to_pano": {
                "type": "integer",
                "minimum": 0
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "transitions": {
          "type": "array",
          "description": "逐边正向运动计划；字段不证明动态画面通过",
          "items": {
            "type": "object",
            "required": [
              "from_pano",
              "to_pano",
              "movement",
              "view",
              "duration_s"
            ],
            "properties": {
              "from_pano": {
                "type": "integer",
                "minimum": 0
              },
              "to_pano": {
                "type": "integer",
                "minimum": 0
              },
              "movement": {
                "const": "forward"
              },
              "view": {
                "type": "string",
                "minLength": 1
              },
              "duration_s": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "design_system": {
            "properties": {
              "version": {
                "enum": [
                  "1.1.0",
                  "1.2.0"
                ]
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "review_route"
        ]
      }
    }
  ]
}
